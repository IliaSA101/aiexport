#!/bin/sh
# Pre-push: последний рубеж перед GitHub. Отправленное в публичный репозиторий не забрать:
# переписанная история оставляет старые объекты доступными по прямой ссылке.
# Страж проверяет каждый новый коммит (файлы и сообщение), тексты меток и дерево отправляемой
# вершины. Он лежит в приватной оснастке; у клона без неё хук молчит.
# Подключается тем же `git config core.hooksPath scripts/git-hooks`; на Linux нужен бит исполнения.
# git передаёт имя удалённого первым аргументом, а отправляемые ссылки — на stdin.
if [ -f .claude/hooks/public-guard.mjs ] && command -v node >/dev/null 2>&1; then
  exec node .claude/hooks/public-guard.mjs --pre-push "$1"
fi
exit 0
