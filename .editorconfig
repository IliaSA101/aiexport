root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab

[go.mod]
indent_style = tab

# В Markdown два пробела на конце строки — это перенос, их нельзя срезать
[*.md]
trim_trailing_whitespace = false

# Windows PowerShell 5.1 читает .ps1 без BOM как ANSI и ломает кириллицу
[scripts/*.ps1]
charset = utf-8-bom
indent_size = 4

[Makefile]
indent_style = tab
